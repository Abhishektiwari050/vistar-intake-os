# ==============================================================================
# VISTAR INTAKE OS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development, or configure these variables
# in your container environment / deployment orchestrator (Docker, AWS, Vercel, Supabase).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & SERVER
# ------------------------------------------------------------------------------
# Execution environment: 'development' | 'production' | 'test'
# Default: development
NODE_ENV=development

# HTTP Server port to listen on
# Default: 3000
PORT=3000

# Server network binding address (use 0.0.0.0 for Docker containers)
# Default: 0.0.0.0
HOSTNAME=0.0.0.0

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (DUAL-MODE DRIZZLE ORM)
# ------------------------------------------------------------------------------
# Dual-Mode Persistence Strategy:
# - If DATABASE_URL is UNSET:
#   Vistar Intake OS automatically utilizes embedded @electric-sql/pglite
#   persisting to the local filesystem at ./data/intake_pgdata.
#   (Zero external dependencies required for local development).
#
# - If DATABASE_URL is SET:
#   Vistar Intake OS connects to the designated PostgreSQL instance (e.g. Postgres 16, Supabase, Neon).
#
# Docker Compose default:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vistar_intake
#
# Optional remote PostgreSQL URL:
# DATABASE_URL=postgres://postgres:postgres@postgres:5432/vistar_intake

# Enable SSL mode for remote database connections (required for Supabase, AWS RDS, Neon)
# Options: 'true' | 'false'
# Default: false
DATABASE_SSL=false

# ------------------------------------------------------------------------------
# 3. AI & MULTIMODAL INTELLIGENCE (OPTIONAL)
# ------------------------------------------------------------------------------
# Google Gemini API key used for:
# 1. Semantic header mapping fallback (when Memory Cache and deterministic aliases do not match)
# 2. Multimodal vision-to-row SKU linking for photos without barcode/SKU tokens
#
# If omitted, deterministic mapping and tokenized image matching remain 100% operational.
# GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 4. WEBHOOK & EXPORT INTEGRATIONS (OPTIONAL)
# ------------------------------------------------------------------------------
# Shared HMAC-SHA256 secret key for signing webhook dispatch payloads.
# When configured, outbound webhook requests include 'x-vistar-signature' header.
# WEBHOOK_SIGNING_SECRET=your_webhook_hmac_secret_key_here
